import java.io.*;
import java.time.LocalDate;
import java.time.format.DateTimeFormatter;
import java.util.ArrayList;
import java.util.Random;
import java.util.Scanner;
import org.apache.poi.ss.usermodel.*;

public class chessColourGuessGame {

    public static void main(String[] args) throws IOException {

        Scanner scanner = new Scanner(System.in);
        Random random = new Random();

        int score = 0;
        int total = 0;
        double totalTime = 0;

        System.out.println("welcome!");

        while(true){
            int number = random.nextInt(0, 63);

            System.out.println("What is the colour of the following tile (b / w)? Enter q to quit");
            String tile = getTile(number);
            System.out.println(tile);

            double startTime = System.currentTimeMillis();
            String guess = scanner.nextLine();
            double stopTime = System.currentTimeMillis();
            double reactionTime = (stopTime - startTime) / 1000;

            char columnLetter = tile.charAt(0);
            int columnNumber = columnLetter - 'a' + 1;
            int rowNumber = tile.charAt(1);

            String colour = checkColour(columnNumber, rowNumber);
            if(guess.equals("q")){
                break;
            } else if(guess.equals("b") || guess.equals("w")) {
                if (guess.equals(colour)){
                    System.out.println("CORRECT     reaction time: " + String.format("%.2f", reactionTime) + " s");
                    total++;
                    score++;
                    totalTime += reactionTime;
                } else{
                    System.out.println("wrong       reaction time: " + String.format("%.2f", reactionTime) + " s");
                    total++;
                    totalTime += reactionTime;
                }
            } else{
                System.out.println("enter valid response");
            }
        }
        System.out.println("Score: " + score + "/" + total);
        System.out.println("Average reaction time: " + String.format("%.2f", (totalTime/total)) + " seconds");
        System.out.println("bye");

        String fileName = "scores.xlsx";

        File masterFile = new File(fileName);
        FileInputStream inputStreamExcel = new FileInputStream(masterFile);

        Workbook wb = WorkbookFactory.create(inputStreamExcel);
        Sheet dataset = wb.getSheetAt(0);
        int totalRows = dataset.getLastRowNum();
        Row nextRow = dataset.createRow(totalRows + 1);

        Cell cellDate = nextRow.createCell(0);
        LocalDate date = LocalDate.now();
        DateTimeFormatter dateFormatter = DateTimeFormatter.ofPattern("dd/MM/yyyy");
        String dateFormatted = date.format(dateFormatter);
        cellDate.setCellValue(dateFormatted);

        Cell cellScore = nextRow.createCell(1);
        cellScore.setCellValue(score);

        Cell cellTotal = nextRow.createCell(2);
        cellTotal.setCellValue(total);

        Cell cellTime = nextRow.createCell(3);
        cellTime.setCellValue(totalTime/total);

        inputStreamExcel.close();
        try(FileOutputStream outputStream = new FileOutputStream(masterFile)){
            wb.write(outputStream);
            wb.close();
        } catch(IOException e){
            System.out.println("error");
        }


    }
    public static String checkColour(int columnNumber, int rowNumber) {
        if (columnNumber % 2 == 0) {
            if (rowNumber % 2 == 0) {
                return "b";
            } else {
                return "w";
            }
        } else {
            if (rowNumber % 2 == 0) {
                return "w";
            } else {
                return "b";
            }
        }
    }
    public static String getTile(int number){
        ArrayList<String> tiles = new ArrayList<>();

        for(char file = 'a'; file <= 'h'; file++){
            for(int rank = 1; rank <= 8; rank++){
                tiles.add(file + String.valueOf(rank));
            }
        }
        return tiles.get(number);
    }
}





